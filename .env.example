# Runtime
APP_NAME=Jubilee Learning Hub
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Local host connection. Docker Compose overrides DATABASE_URL inside containers.
DATABASE_URL=postgresql+psycopg://trainsyt:trainsyt-local-password@localhost:5432/trainsyt
DATABASE_ECHO=false
POSTGRES_DB=trainsyt
POSTGRES_USER=trainsyt
POSTGRES_PASSWORD=trainsyt-local-password
# Set this when the password needs URL encoding or the database is externally hosted.
# CONTAINER_DATABASE_URL=postgresql+psycopg://user:encoded-password@postgres:5432/trainsyt

# Authentication — generate distinct random values of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=trainsyt-api
JWT_AUDIENCE=trainsyt-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TEMP_TOKEN_EXPIRE_MINUTES=15
ATTENDANCE_TOKEN_EXPIRE_HOURS=72
INITIAL_ADMIN_SECRET_KEY=replace-with-a-separate-bootstrap-secret
SEED_ADMIN_EMAIL=admin@trainsyt.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# Browser security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# Transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_USE_TLS=true
FROM_EMAIL=mailer@example.com
FROM_NAME=Jubilee Learning Hub

# Password reset verification
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_MINUTES=10
